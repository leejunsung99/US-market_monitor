# Copy to .env. Never commit actual values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FINNHUB_API_KEY=
# SEC requires an identifying application name and real contact email.
SEC_USER_AGENT=
# Reserved for a future optional module; v1 never calls an AI API.
OPENAI_API_KEY=
AI_SUMMARY_ENABLED=false
SEC_ENABLED=true
FED_ENABLED=true
FINNHUB_ENABLED=true
SEC_INTERVAL_SECONDS=120
FED_INTERVAL_SECONDS=120
FINNHUB_INTERVAL_SECONDS=120
# Lower this to fit your account's plan.
FINNHUB_REQUESTS_PER_MINUTE=30
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
MAX_NOTIFICATION_AGE_HOURS=24
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
WATCHLIST_PATH=settings/watchlist.yaml
FILTERS_PATH=settings/filters.yaml
RELATIONS_PATH=settings/industry_relations.yaml
