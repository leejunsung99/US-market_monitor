# Copy to .env. Never commit actual values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FINNHUB_API_KEY=
# SEC requires an identifying application name and real contact email.
SEC_USER_AGENT=
# Reserved for a future optional module; v1 never calls an AI API.
OPENAI_API_KEY=
AI_SUMMARY_ENABLED=false
SEC_ENABLED=true
FED_ENABLED=true
FINNHUB_ENABLED=true
SEC_INTERVAL_SECONDS=120
FED_INTERVAL_SECONDS=120
FINNHUB_INTERVAL_SECONDS=120
# Free official economic indicator RSS feeds; no API keys required.
ECONOMIC_ENABLED=true
ECONOMIC_INTERVAL_SECONDS=120
# Applied only when these four sources have no saved baseline yet.
ECONOMIC_INITIAL_LOOKBACK_HOURS=24
BLS_CPI_RSS_URL=https://www.bls.gov/feed/cpi.rss
BLS_PPI_RSS_URL=https://www.bls.gov/feed/ppi.rss
BLS_EMPLOYMENT_RSS_URL=https://www.bls.gov/feed/empsit.rss
BEA_RSS_URL=https://apps.bea.gov/rss/rss.xml
BLS_JOLTS_RSS_URL=https://www.bls.gov/feed/jolts.rss
CENSUS_RSS_URL=https://www.census.gov/economic-indicators/indicator.xml
DOL_CLAIMS_PDF_URL=https://www.dol.gov/ui/data.pdf
EIA_WEEKLY_CSV_URL=https://ir.eia.gov/wpsr/psw00.csv
# Public official company newsrooms and Commerce BIS; no paid keys.
PUBLIC_SOURCES_ENABLED=true
PUBLIC_SOURCE_INTERVAL_SECONDS=600
OFFICIAL_SOURCES_PATH=settings/official_sources.yaml
# all = every verified release in connected channels; material = importance rules.
OFFICIAL_ALERT_SCOPE=all
# Compare collected Census releases with its official calendar (30-minute grace).
RELEASE_MONITOR_ENABLED=true
# Lower this to fit your account's plan.
FINNHUB_REQUESTS_PER_MINUTE=30
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
MAX_NOTIFICATION_AGE_HOURS=24
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
WATCHLIST_PATH=settings/watchlist.yaml
FILTERS_PATH=settings/filters.yaml
RELATIONS_PATH=settings/industry_relations.yaml

# Optional standard Azure NMT translation (Translator F0 resource).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
